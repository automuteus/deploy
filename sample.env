# Please refer to the latest stable version of AutoMuteUs when specifying this version.
# Note, using versions that are not SemVer format (x.y.z) is NOT recommended, as these can be experimental or unsupported
AUTOMUTEUS_TAG=
# API and Galactus use AUTOMUTEUS_TAG when they are blank (recommended)
# All are versioned together with the same semantic version number
GALACTUS_TAG=
API_TAG=

# Automuteus: https://github.com/automuteus/automuteus/releases
# or https://hub.docker.com/r/automuteus/automuteus/tags
# Galactus and API share the AutoMuteUs release version above.
# or https://hub.docker.com/r/automuteus/galactus/tags
# API: https://hub.docker.com/r/automuteus/api/tags

# change these, but see comment block down below about HOST/PORT
DISCORD_BOT_TOKEN=
GALACTUS_HOST=http://localhost:8123
GALACTUS_EXTERNAL_PORT=8123
# GALACTUS_HOST can include the port or not. If you don't include the port,
# it will default to :80/:443 depending on http:// v https://
# **Make sure that GALACTUS_EXTERNAL_PORT matches the Port for the above host, UNLESS you use a reverse proxy/nginx!!!**
# Ex: if GALACTUS_HOST=http://localhost, then GALACTUS_EXTERNAL_PORT should be 80 (HTTP)
# Ex: if GALACTUS_HOST=https://localhost, then GALACTUS_EXTERNAL_PORT should be 443 (HTTPS)
# Ex: if GALACTUS_HOST=http://localhost:8123, then GALACTUS_EXTERNAL_PORT should be 8123
# If you use a reverse proxy, then GALACTUS_HOST should have the port of your reverse proxy, and it should proxy to the
# GALACTUS_EXTERNAL_PORT (ex 443 -> 8123)

# recommend changing these to something more secure
POSTGRES_USER=postgres
POSTGRES_PASS=putsomesecretpasswordhere

# Optional, leave alone by default
# Public host port, mapped to the separate API container (default 8080).
API_PORT=
# Defaults to http://localhost:${API_PORT:-8080}, including in capture links.
# Set an externally accessible URL if capture runs on another machine or behind a proxy.
API_SERVER_URL=
API_ADMIN_PASS=
EMOJI_GUILD_ID=
BASE_MAP_URL=
# comma-separated
WORKER_BOT_TOKENS=
CAPTURE_TIMEOUT=
AUTOMUTEUS_LISTENING=
# comma-separated
SLASH_COMMAND_GUILD_IDS=
STOP_GRACE_PERIOD=
# text (default) or json; debug, info (default), warn, or error. Apply to the bot, API, and Galactus.
LOG_FORMAT=
LOG_LEVEL=
# How long Galactus keeps running after a stop signal before ending its games and exiting. Defaults to 5.
DRAIN_SECONDS=

# Web dashboard, where guild settings are managed. These three are required:
# a random secret, e.g. `openssl rand -base64 32`
NEXTAUTH_SECRET=
# the OAuth2 client ID and secret of your Discord application (the bot's application works)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Optional. The dashboard's public URL, which the bot's /settings command links to; defaults to
# http://localhost:${WEB_PORT:-3000}, which only works for people on this machine. Set it to the real URL when the
# dashboard is exposed or behind a reverse proxy. Either way, add <WEB_URL>/api/auth/callback/discord as a redirect
# in your Discord application's OAuth2 settings.
WEB_URL=
# Optional. Public host port for the dashboard (default 3000).
WEB_PORT=
# Optional. Image version; the dashboard is released separately from the bot. https://hub.docker.com/r/automuteus/react-web/tags
WEB_TAG=

# DO NOT change these unless you really know what you're doing
# Internal API container port; the bot no longer listens here.
SERVICE_PORT=5000
BROKER_PORT=8123
REDIS_ADDR=redis:6379
POSTGRES_ADDR=postgres:5432
